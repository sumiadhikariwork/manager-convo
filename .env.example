# =========================================================================
# Server deployment (Docker, Render, Railway, Fly, a VM)
# Persistent disk, background thread, audio never leaves the machine.
# =========================================================================

SPEECH_PROVIDER=faster_whisper
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

STORAGE_BACKEND=local
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/manager_convo.sqlite3
JOB_RUNNER=thread

ANALYSIS_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

MAX_UPLOAD_MB=200

# =========================================================================
# Serverless deployment (Vercel) - see the README's Deploying section.
# No disk, no background execution, capped request bodies. Uncomment and
# fill in; leave the block above unset.
# =========================================================================

# JOB_RUNNER=deferred
# AUTO_CREATE_TABLES=false
# DATABASE_URL=postgresql://user:password@host/dbname
# PUBLIC_BASE_URL=https://your-app.vercel.app
# WEBHOOK_SECRET=

# STORAGE_BACKEND=s3
# STORAGE_BUCKET=conversation-recordings
# STORAGE_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_BASE_URL=

# SPEECH_PROVIDER=assemblyai
# ASSEMBLYAI_API_KEY=
# ASSEMBLYAI_LANGUAGE=
# ASSEMBLYAI_SPEAKERS_EXPECTED=2

# =========================================================================
# Offline / demo
# =========================================================================

# SPEECH_PROVIDER=fixture      # reads a sidecar transcript next to the audio
# ANALYSIS_PROVIDER=heuristic  # no API key needed; extractive drafting
