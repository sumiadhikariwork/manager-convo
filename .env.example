# ---- Speech to text -------------------------------------------------------
# faster_whisper : local Whisper (pip install -r requirements-asr.txt)
# fixture        : reads a sidecar <audio>.transcript.json / .txt next to the
#                  upload. Used by the test suite and for offline demos.
SPEECH_PROVIDER=faster_whisper
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# ---- Understanding (alignment + form drafting) ----------------------------
# claude    : use the Claude API (requires ANTHROPIC_API_KEY)
# heuristic : fully offline keyword/timing aligner + extractive drafter
ANALYSIS_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# ---- Storage --------------------------------------------------------------
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/manager_convo.sqlite3
MAX_UPLOAD_MB=200
